# ============================================================
# Environment Configuration
# Copy to .env and fill in real values
# ============================================================

# ----- Application -----
APP_NAME="SamaadSetu Grievance Portal"
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","file://"]

# ----- PostgreSQL + PostGIS -----
DATABASE_URL=postgresql+asyncpg://grievance:grievance@localhost:5432/grievancedb
DATABASE_URL_SYNC=postgresql://grievance:grievance@localhost:5432/grievancedb
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ----- Qdrant Vector DB -----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=grievance_vectors
QDRANT_VECTOR_SIZE=1024      # multilingual-e5-large output dim

# ----- OpenAI (Whisper ASR + GPT-4o VLM + text-embedding-3-large) -----
OPENAI_API_KEY=sk-...
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_VLM_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-large

# ----- Google Cloud (Fallback ASR / TTS) -----
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_TTS_LANGUAGE_CODE=hi-IN

# ----- File Storage -----
MEDIA_STORAGE_BACKEND=local  # local | s3 | gcs
MEDIA_LOCAL_DIR=/data/media
AWS_S3_BUCKET=grievance-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ----- Geocoding -----
NOMINATIM_USER_AGENT=jan-shakti-grievance-portal
REVERSE_GEOCODE_TIMEOUT_S=5

# ----- AI Pipeline Thresholds -----
DEDUP_COSINE_THRESHOLD=0.92     # above → duplicate candidate
PHASH_HAMMING_THRESHOLD=8       # below → recycled image flag
PROOF_MIN_RELEVANCE_SCORE=0.35  # below → request clearer proof
GPS_DRIFT_MAX_METERS=500        # EXIF vs claim distance tolerance

# ----- WebSocket / SSE -----
WS_HEARTBEAT_INTERVAL_S=30
SSE_RETRY_MS=3000

# ----- JWT Auth -----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OFFICER_TOKEN_EXPIRE_MINUTES=480
